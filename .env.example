# ==============================================================================
# Adaptive Technical Interview Simulator — Environment Configuration Example
# Copy this file to .env and adjust values for your local or production setup.
# Never commit real API keys or production passwords to version control.
# ==============================================================================

# --- MySQL 8 Database (Mandatory Primary Database) ---
DB_HOST=127.0.0.1
DB_PORT=3006
DB_NAME=interview_simulator
DB_TEST_NAME=interview_simulator_test
DB_USER=interview_app
DB_PASSWORD=replace_with_your_db_password

# --- Authentication & Security ---
JWT_SECRET=replace_with_a_minimum_256_bit_secret_key_for_jwt_signing
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Isolated Code Execution Service (runner-service) ---
RUNNER_PORT=8085
RUNNER_SERVICE_URL=http://127.0.0.1:8085
# Options: AUTO (uses DOCKER_CONTAINER if Docker daemon is reachable, else RESTRICTED_LOCAL_SANDBOX),
#          DOCKER_CONTAINER, or RESTRICTED_LOCAL_SANDBOX
RUNNER_ISOLATION_MODE=AUTO
RUNNER_DOCKER_IMAGE=eclipse-temurin:21-jdk-alpine
RUNNER_TIMEOUT_MS=4000
RUNNER_MAX_MEMORY_MB=128
RUNNER_MAX_OUTPUT_CHARS=8192

# --- AI Interviewer, Rubric Evaluation & AI Resume Screener ---
# Supports any OpenAI-compatible Chat Completions endpoint (OpenAI, Gemini OpenAI compatibility, Groq, Ollama).
# Example for Google Gemini (OpenAI-compatible endpoint):
#   AI_PROVIDER=gemini
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash
#   AI_API_KEY=your_api_key_here
# Example for OpenAI:
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini
#   AI_API_KEY=your_api_key_here
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_api_key_here
AI_TIMEOUT_MS=15000

# --- Resume Screener Limits ---
RESUME_MAX_UPLOAD_BYTES=5242880

# --- Frontend ---
VITE_API_BASE_URL=
